<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.nutricheckproject.ui.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_patientListFragment"
            app:destination="@id/patientListFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/patientListFragment"
        android:name="com.example.nutricheckproject.ui.PatientListFragment"
        android:label="Pacientes"
        tools:layout="@layout/fragment_patient_list">

        <action
            android:id="@+id/action_patientList_to_patientProfile"
            app:destination="@id/patientProfileFragment" />


        <action
            android:id="@+id/action_patientList_to_patientDetail"
            app:destination="@id/patientDetailFragment" />

        <action
            android:id="@+id/action_patientList_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/calorieCalculatorFragment"
        android:name="com.example.nutricheckproject.ui.CalorieCalculatorFragment"
        android:label="@string/calc_energy_title"
        tools:layout="@layout/fragment_calorie_calculator">
        <argument
            android:name="patientId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/macroCalculatorFragment"
        android:name="com.example.nutricheckproject.ui.MacroCalculatorFragment"
        android:label="@string/macro_title"
        tools:layout="@layout/fragment_macro_calculator">
        <argument
            android:name="patientId"
            app:argType="string" />
    </fragment>


    <fragment
        android:id="@+id/waterCalculatorFragment"
        android:name="com.example.nutricheckproject.ui.WaterCalculatorFragment"
        android:label="@string/water_title"
        tools:layout="@layout/fragment_water_calculator">
        <argument
            android:name="patientId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/espenCalculatorFragment"
        android:name="com.example.nutricheckproject.ui.EspenCalculatorFragment"
        android:label="@string/espen_title"
        tools:layout="@layout/fragment_espen_calculator">
        <argument
            android:name="patientId"
            app:argType="string" />
    </fragment>


    <fragment
        android:id="@+id/patientProfileFragment"
        android:name="com.example.nutricheckproject.ui.PatientProfileFragment"
        android:label="@string/perfil_del_paciente"
        tools:layout="@layout/fragment_patient_profile">

        <argument
            android:name="patientId"
            app:argType="string" />

        <action
            android:id="@+id/action_patientProfile_to_patientDetail"
            app:destination="@id/patientDetailFragment" />

        <action
            android:id="@+id/action_patientProfile_to_calorieCalculator"
            app:destination="@id/calorieCalculatorFragment" />

        <action
            android:id="@+id/action_patientProfile_to_macroCalculator"
            app:destination="@id/macroCalculatorFragment" />

        <action
            android:id="@+id/action_patientProfile_to_waterCalculator"
            app:destination="@id/waterCalculatorFragment" />

        <action
            android:id="@+id/action_patientProfile_to_espenCalculator"
            app:destination="@id/espenCalculatorFragment" />
    </fragment>

    <fragment
        android:id="@+id/patientDetailFragment"
        android:name="com.example.nutricheckproject.ui.PatientDetailFragment"
        android:label="@string/detalle_del_paciente"
        tools:layout="@layout/fragment_patient_detail">

        <argument
            android:name="patientId"
            app:argType="string"
            android:defaultValue="new" />
    </fragment>


</navigation>
